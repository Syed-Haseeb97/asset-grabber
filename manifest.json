{
  "manifest_version": 3,
  "name": "Asset Grabber",
  "version": "2.0.0",
  "description": "Paste any link: list every image, video, audio file, PDF and document, download them, and audit the site's files and headers for security leaks before you deploy.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Asset Grabber",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "scripting",
    "storage",
    "clipboardWrite",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}